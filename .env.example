# RESET_SECRET: Required authorization secret to invoke POST /api/reset
RESET_SECRET=

# SUPERADMIN_SECRET: Low-overhead header key signature for /api/superadmin/global-pulse telemetry
SUPERADMIN_SECRET=

# ADMIN_PASSCODE: Master passcode for administrative staff access in production
ADMIN_PASSCODE=

# PULSE_CACHE_TTL_MS: In-memory cache TTL in milliseconds for cross-tenant pulse queries (defaults to 15000)
PULSE_CACHE_TTL_MS=15000

# Port for the Node.js / Express backend server (defaults to 3000)
PORT=3000

# Application Host URL (e.g. https://your-elshop-domain.ae)
APP_URL=http://localhost:3000

# Node Environment
NODE_ENV=development

